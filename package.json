{
  "name": "n8n-nodes-apivault-google-maps-contacts",
  "version": "0.1.1",
  "description": "n8n community node for Google Maps Contacts, backed by the apivault_labs/google-maps-scraper-emails-contact-details-leads Apify Actor.",
  "license": "MIT",
  "homepage": "https://apify.com/apivault_labs/google-maps-scraper-emails-contact-details-leads",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "apify",
    "automation",
    "lead-generation",
    "google",
    "maps",
    "contacts"
  ],
  "author": {
    "name": "apivault_labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apivault-labs/n8n-nodes-apivault-google-maps-contacts.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GoogleMapsContacts/GoogleMapsContacts.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
